# Keep the build context small and stop non-runtime files reaching the image.
# The Dockerfile only COPYs web-ui/, scripts/, config/, web-ui/requirements.txt and
# the CSS build inputs (build_css.sh, tailwind.config.js, tailwind.input.css), so
# everything here is either never used or must never be baked in.

# VCS and editor state (.git alone is several MB of context)
.git
.gitignore
.github
.vscode

# Tests and their fixtures are run from the source tree, not from the image
tests
run_tests.sh

# Docs and assets
*.md
screenshot.png

# Local helper scripts
run.sh
publish_dockerhub.sh
publish_github.sh

# Host-side build state: the image builds its own tailwind.css in the css_builder
# stage, and a host .cache/ holds a CLI for the wrong platform.
.cache
.venv
web-ui/static/css/tailwind.css
# The build label arrives as a build arg; an old file here must never be baked in.
web-ui/BUILD

# Python bytecode: stale .pyc files inside the image are worse than useless
__pycache__
**/__pycache__
*.py[cod]
.python-version

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
